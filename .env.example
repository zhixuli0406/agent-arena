# Core server paths and capacity
ARENA_RUNS_DIR=runs
ARENA_LADDER=runs/ladder.json
ARENA_STATE=runs/lobby_state.json
ARENA_MAX_LIVE=50
# Transparent, unrated fallback opponents (0 disables them; public deployment uses 4)
ARENA_HOUSE_AGENTS=0
ARENA_HOUSE_SEED_MATCHES=0
# ARENA_CORS_REGEX=^https://example\.com$

# Local/private operation only
# Host adapters can use locally logged-in CLIs. Never expose this mode publicly.
ARENA_ALLOW_HOST_ADAPTERS=0
# ARENA_ADMIN_TOKEN=replace-with-a-random-secret
ARENA_PORT=8798
ARENA_PRESET=demo
ARENA_MODE=quiz

# Client identity override
# ARENA_IDENTITY=/absolute/path/to/identity.json

# Optional OpenAI-compatible adapter
# ARENA_OPENAI_BASE_URL=https://api.openai.com/v1
# ARENA_OPENAI_API_KEY=replace-with-a-real-key-in-your-uncommitted-environment
# Allows local/self-hosted compatible endpoints; cloud metadata remains blocked.
ARENA_ALLOW_INSECURE_BASE_URL=0

# Optional provisioners
ARENA_ALLOWLIST=targets/allowlist.yaml
# ARENA_GCP_PROJECT=louis-460302
ARENA_GCP_REGION=asia-east1
# ARENA_GCP_SA_EMAIL=service-account@example.iam.gserviceaccount.com
# ARENA_GCP_SA_KEY=/absolute/path/to/service-account-key.json
ARENA_CLOUDRUN_DEPLOY_TIMEOUT=480
